# Application
APP_ENV=development
APP_DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_REQUEST_TIMEOUT_SECONDS=10
INGESTION_LEASE_SECONDS=900
TRANSCRIPT_LANGUAGES=en
TRANSCRIPT_CHUNK_SIZE=1000
TRANSCRIPT_CHUNK_OVERLAP=200
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
VECTOR_INSERT_BATCH_SIZE=100

# Supabase
# Use the modern publishable and secret keys from Project Settings > API Keys.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Local LLM configuration
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
LLM_TEMPERATURE=0.1
LLM_REQUEST_TIMEOUT_SECONDS=120
RAG_TOP_K=4
CHAT_HISTORY_MESSAGES=6

# Hosted Groq configuration. Set LLM_PROVIDER=hosted in production.
HOSTED_API_BASE_URL=https://api.groq.com/openai/v1
HOSTED_API_KEY=
HOSTED_MODEL_NAME=llama-3.1-8b-instant

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

TRANSCRIPT_PROXY_USERNAME=
TRANSCRIPT_PROXY_PASSWORD=
